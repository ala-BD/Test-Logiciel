  usecase "Modifier un membre"               as MB5
  usecase "Modifier son propre profil"       as MB6
  usecase "Envoyer email de bienvenue"       as MB7
  usecase "Obtenir son QR code"              as MB8
}

A --> MB1
A --> MB2
A --> MB3
A --> MB4
A --> MB5
M --> MB6
M --> MB7
M --> MB8
S --> MB1
