@startuml
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam usecaseBackgroundColor #F8F9FF
skinparam usecaseBorderColor #4455AA
skinparam actorBackgroundColor #D6EAF8
skinparam actorBorderColor #1A5276
skinparam usecase {
  BackgroundColor<<auto>> #FFFACD
  BorderColor<<auto>> #C9A800
}
left to right direction

title DeskyWork - Partie 3 : Admin KPIs, Espaces, Documents, RGPD, Multi-Sites, Super Admin

' ─── ACTEURS (humains uniquement) ──────────────
' Visiteur = non connecte (guest public)
actor "Visiteur"    as V
actor "Membre"      as M
actor "Staff"       as S
actor "Admin"       as A
actor "Super Admin" as SA

M --|> V
S --|> M
A --|> S

' ─── TABLEAU DE BORD ADMIN & KPIs ──────────────
' kpis.routes.js | kpisController.js | reportController.js
' AdminDashboard.jsx | AdminAgenda.jsx
package "Tableau de Bord Admin et KPIs" {
  usecase "Consulter KPIs (CA, occupation)" as K1
  usecase "Voir graphique evolution CA"      as K2
  usecase "Generer rapport intelligent"      as K3
  usecase "Consulter agenda du jour"         as K4
  usecase "Exporter donnees Excel"           as K5
}

A --> K1
A --> K2
A --> K3
A --> K4
A --> K5
S --> K4

' ─── GESTION ESPACES ───────────────────────────
' espaces.routes.js | espacesController.js
' AdminEspaces.jsx
package "Gestion des Espaces" {
  usecase "Lister les espaces"               as E1
  usecase "Creer un espace"                  as E2
  usecase "Modifier un espace"               as E3
  usecase "Supprimer un espace"              as E4
  usecase "Uploader photo d'un espace"       as E5
  usecase "Lister espaces de formation"      as E6
}

A --> E2
A --> E3
A --> E4
A --> E5
M --> E1
M --> E6
V --> E1

' ─── GESTION MEMBRES ───────────────────────────
