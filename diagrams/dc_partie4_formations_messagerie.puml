@startuml
skinparam classBackgroundColor #FFF0F5
skinparam classBorderColor #880E4F
skinparam classHeaderBackgroundColor #880E4F
skinparam classHeaderFontColor #FFFFFF
skinparam ArrowColor #333333
skinparam linetype ortho

title Diagramme de Classes - Partie 4 : Formations, Messagerie, Notifications

class "formations" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  titre : TEXT
  description : TEXT
  formateur_id : UUID <<FK profiles>>
  espace_id : UUID <<FK espaces>>
  date_debut : TIMESTAMPTZ
  date_fin : TIMESTAMPTZ
  capacite_max : INTEGER
  prix_inscription : NUMERIC(10,2)
  statut : TEXT
  programme : TEXT
  prerequis : TEXT
  materiel : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "inscriptions_formations" {
  +id : UUID <<PK>>
  --
  formation_id : UUID <<FK formations>>
  user_id : UUID <<FK profiles>>
  guest_id : UUID <<FK guests>>
  statut : TEXT
  statut_paiement : TEXT
  paiement_id : UUID <<FK paiements>>
  present : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "remuneration_formateurs" {
  +id : UUID <<PK>>
  --
  formateur_id : UUID <<FK profiles>>
  formation_id : UUID <<FK formations>>
  montant : NUMERIC(10,2)
  statut : TEXT
  date_versement : TIMESTAMPTZ
  note : TEXT
  created_at : TIMESTAMPTZ
}

class "conversations" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  title : TEXT
  type : TEXT
  created_by : UUID <<FK profiles>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "messages" {
  +id : UUID <<PK>>
  --
  conversation_id : UUID <<FK conversations>>
  sender_id : UUID <<FK profiles>>
  content : TEXT
  read_by : UUID[]
  created_at : TIMESTAMPTZ
}

class "conversation_members" {
  +id : UUID <<PK>>
  --
  conversation_id : UUID <<FK conversations>>
  user_id : UUID <<FK profiles>>
  last_read_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
}

class "notifications" {
  +id : UUID <<PK>>
  --
  user_id : UUID <<FK profiles>>
  type : TEXT
  canal : TEXT
  message : TEXT
  lu : BOOLEAN
  created_at : TIMESTAMPTZ
}

' ── RELATIONS ─────────────────────────────────
formations "1" --> "0..*" inscriptions_formations : formation_id
formations "1" --> "0..*" remuneration_formateurs : formation_id
conversations "1" --> "0..*" messages : conversation_id
conversations "1" --> "0..*" conversation_members : conversation_id

note right of formations
  statut : planifiee | en_cours |
           terminee | annulee
end note

note right of inscriptions_formations
  statut : confirmee | en_attente | annulee
  statut_paiement : gratuit | en_attente |
                    paye | rembourse
  UNIQUE (formation_id, user_id)
end note

note right of conversations
  type : support | group | direct
end note

note right of notifications
  canal : Email | SMS | Dashboard
  Supabase Realtime active
end note

@enduml
