@startuml
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #F57F17
skinparam classHeaderBackgroundColor #F57F17
skinparam classHeaderFontColor #FFFFFF
skinparam ArrowColor #333333
skinparam linetype ortho

title Diagramme de Classes - Partie 3 : Abonnements, Paiements, Tarification

class "abonnements" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  user_id : UUID <<FK profiles>>
  site_id : UUID <<FK sites>>
  type : TEXT
  date_debut : DATE
  date_fin : DATE
  renouvellement_auto : BOOLEAN
  statut : TEXT
  type_espace : TEXT
  multi_sites : BOOLEAN
  created_at : TIMESTAMPTZ
}

class "paiements" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  user_id : UUID <<FK profiles>>
  reservation_id : UUID <<FK reservations>>
  abonnement_id : UUID <<FK abonnements>>
  montant : NUMERIC(10,2)
  mode : TEXT
  statut : TEXT
  date_paiement : TIMESTAMPTZ
  numero_recu : TEXT
  reference_externe : TEXT
  montant_rembourse : NUMERIC(10,2)
  created_at : TIMESTAMPTZ
}

class "tarifs_abonnements" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  type_abonnement : TEXT
  plan_tarifaire : TEXT
  type_espace : TEXT
  prix : NUMERIC(10,2)
  tva_pct : NUMERIC(5,2)
  actif : BOOLEAN
  date_debut : DATE
  date_fin : DATE
  created_at : TIMESTAMPTZ
}

class "codes_promo" {
  +id : UUID <<PK>>
  --
  tenant_id : UUID <<FK tenants>>
  code : TEXT <<UNIQUE>>
  type_reduction : TEXT
  valeur : NUMERIC(10,2)
  actif : BOOLEAN
  date_debut : DATE
  date_fin : DATE
  utilisations_max : INTEGER
  utilisations_count : INTEGER
  created_at : TIMESTAMPTZ
}

class "historique_tarifs" {
  +id : UUID <<PK>>
  --
  user_id : UUID <<FK profiles>>
  abonnement_id : UUID <<FK abonnements>>
  type_abonnement : TEXT
  plan_tarifaire : TEXT
  prix_initial : NUMERIC(10,2)
  prix_final : NUMERIC(10,2)
  code_promo_id : UUID <<FK codes_promo>>
  created_at : TIMESTAMPTZ
}

' ── RELATIONS ─────────────────────────────────
abonnements "0..*" --> "1" profiles : user_id
paiements "0..*" --> "1" profiles : user_id
paiements "0..1" --> "1" reservations : reservation_id
paiements "0..1" --> "1" abonnements : abonnement_id
historique_tarifs "0..*" --> "1" abonnements : abonnement_id
historique_tarifs "0..*" --> "0..1" codes_promo : code_promo_id

note right of abonnements
  type : day_pass | week_pass |
         mensuel | trimestriel |
         annuel | bureau_prive
  statut : active | suspended | expired
end note

note right of paiements
  mode : cash | bank_transfer |
         check | online
  statut : pending | paid |
           failed | refunded
end note

note right of codes_promo
  type_reduction : percent | fixed
end note

@enduml
